# Server configuration. Copy this file to server/.env and fill in the values.
# The server listens on port 3000.

# --- Database (must match db/.env) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=libre_train
DB_PASSWORD=change_me
DB_NAME=libre_train

# --- Auth secrets (required) ---
# The server exits on startup if either of these is missing.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me

# --- CORS ---
# Origin allowed to call the API (the client's dev server URL).
FRONTEND_URL=http://localhost:5173

# node environment (local | dev | prod)
NODE_ENV=local

# --- Object storage (Garage, S3-compatible) — optional ---
# If GARAGE_ENDPOINT / GARAGE_ACCESS_KEY / GARAGE_SECRET_KEY are unset the server still
# boots, but branding logo upload/serving returns 503.
# For host-run dev the S3 port is bound to 127.0.0.1:3900; inside docker compose the
# server overrides GARAGE_ENDPOINT to http://garage:3900.
# Fill ACCESS/SECRET from the one-time `garage key create` bootstrap (see CLAUDE.md).
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET=libre-train-logos
