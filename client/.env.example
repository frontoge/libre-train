# Client (Vite) configuration. Copy this file to client/.env and fill in the values.
# All client env vars must be prefixed with VITE_ to be exposed to the browser.

# Base URL for API fetches; "/api" is appended by getAppConfiguration().
VITE_API_URL=http://localhost:3000

# Environment selector: local | dev | prod
VITE_ENV=local

# Base path the SPA is served from (router basename). Leave as "/" for root.
VITE_BASE_URL=/
